include(ExternalProject)
include_directories(${SKIA_SOURCE_DIR})

# Compiler flags
if (MSVC)
    if(ENABLE_ASAN)
    endif ()
endif()

if(ENABLE_ASAN)
    set(ASAN_PREFIX "ASAN")
endif()

if(WIN32)
    set(SKIA_SUFFIX ".bat")
else ()
    set(SKIA_SUFFIX ".sh")
endif ()

if(WIN32)
    set(SHELL_CMD "cmd" "/C")
else()
    set(SHELL_CMD "") # Unix can usually execute .sh directly if permissions are set
endif()

if(NOT WIN32)
    execute_process(COMMAND chmod +x "${SKIA_SOURCE_DIR}/build_all.sh")
    execute_process(COMMAND chmod +x "${SKIA_SOURCE_DIR}/bin/ninja")
endif()

if (CMAKE_BUILD_TYPE STREQUAL "Debug")
    set(BUILD_TYPE_SKIA DEBUG)
else()
    set(BUILD_TYPE_SKIA RELEASE)
endif()


ExternalProject_Add(
        skia_cmd
        SOURCE_DIR ${SKIA_SOURCE_DIR}
        BINARY_DIR ${SKIA_SOURCE_DIR}

        CONFIGURE_COMMAND ""

        BUILD_COMMAND
        ${SHELL_CMD} 
        "${SKIA_SOURCE_DIR}/build_all${SKIA_SUFFIX}${SCRIPT_EXT}" 
        "${SKIA_BUILD_DIR}" 
        ${BUILD_TYPE_SKIA}
        "${ASAN_CODE}" 
        "${ASAN_PREFIX}"

        INSTALL_COMMAND ""
        USES_TERMINAL_BUILD true
)

if (CMAKE_BUILD_TYPE STREQUAL "Debug")
    set(BUILD_TYPE Debug)
else()
    set(BUILD_TYPE Release)
endif()


set(SKIA_DIR "${SKIA_BUILD_DIR}/${BUILD_TYPE}${ASAN_PREFIX}")
add_library(skia INTERFACE IMPORTED)
add_dependencies(skia skia_cmd)
set_target_properties(skia PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${SKIA_SOURCE_DIR}"
)

target_link_libraries(skia INTERFACE
    # High-level / Module libraries
    "${SKIA_DIR}/${CMAKE_STATIC_LIBRARY_PREFIX}svg${CMAKE_STATIC_LIBRARY_SUFFIX}"
    "${SKIA_DIR}/${CMAKE_STATIC_LIBRARY_PREFIX}skia${CMAKE_STATIC_LIBRARY_SUFFIX}"
    "${SKIA_DIR}/${CMAKE_STATIC_LIBRARY_PREFIX}skshaper${CMAKE_STATIC_LIBRARY_SUFFIX}"
    "${SKIA_DIR}/${CMAKE_STATIC_LIBRARY_PREFIX}skunicode_icu${CMAKE_STATIC_LIBRARY_SUFFIX}"
    "${SKIA_DIR}/${CMAKE_STATIC_LIBRARY_PREFIX}skunicode_core${CMAKE_STATIC_LIBRARY_SUFFIX}"
    "${SKIA_DIR}/${CMAKE_STATIC_LIBRARY_PREFIX}skresources${CMAKE_STATIC_LIBRARY_SUFFIX}"
    "${SKIA_DIR}/${CMAKE_STATIC_LIBRARY_PREFIX}skcms${CMAKE_STATIC_LIBRARY_SUFFIX}"

    # Third-party dependencies
    "${SKIA_DIR}/${CMAKE_STATIC_LIBRARY_PREFIX}harfbuzz${CMAKE_STATIC_LIBRARY_SUFFIX}"
    "${SKIA_DIR}/${CMAKE_STATIC_LIBRARY_PREFIX}icu${CMAKE_STATIC_LIBRARY_SUFFIX}"
    "${SKIA_DIR}/${CMAKE_STATIC_LIBRARY_PREFIX}webp${CMAKE_STATIC_LIBRARY_SUFFIX}"
    "${SKIA_DIR}/${CMAKE_STATIC_LIBRARY_PREFIX}webp_sse41${CMAKE_STATIC_LIBRARY_SUFFIX}"
    "${SKIA_DIR}/${CMAKE_STATIC_LIBRARY_PREFIX}png${CMAKE_STATIC_LIBRARY_SUFFIX}"
    "${SKIA_DIR}/${CMAKE_STATIC_LIBRARY_PREFIX}jpeg${CMAKE_STATIC_LIBRARY_SUFFIX}"
    "${SKIA_DIR}/${CMAKE_STATIC_LIBRARY_PREFIX}jpeg12${CMAKE_STATIC_LIBRARY_SUFFIX}"
    "${SKIA_DIR}/${CMAKE_STATIC_LIBRARY_PREFIX}jpeg16${CMAKE_STATIC_LIBRARY_SUFFIX}"
    "${SKIA_DIR}/${CMAKE_STATIC_LIBRARY_PREFIX}zlib${CMAKE_STATIC_LIBRARY_SUFFIX}"
    "${SKIA_DIR}/${CMAKE_STATIC_LIBRARY_PREFIX}expat${CMAKE_STATIC_LIBRARY_SUFFIX}"
    "${SKIA_DIR}/${CMAKE_STATIC_LIBRARY_PREFIX}wuffs${CMAKE_STATIC_LIBRARY_SUFFIX}"
    "${SKIA_DIR}/${CMAKE_STATIC_LIBRARY_PREFIX}dng_sdk${CMAKE_STATIC_LIBRARY_SUFFIX}"
    "${SKIA_DIR}/${CMAKE_STATIC_LIBRARY_PREFIX}piex${CMAKE_STATIC_LIBRARY_SUFFIX}"
    # "${SKIA_DIR}/${CMAKE_STATIC_LIBRARY_PREFIX}spvtools${CMAKE_STATIC_LIBRARY_SUFFIX}"
    # "${SKIA_DIR}/${CMAKE_STATIC_LIBRARY_PREFIX}spvtools_val${CMAKE_STATIC_LIBRARY_SUFFIX}"
)

file(GLOB_RECURSE BORA_SKIA_SOURCE ${SKIA_SOURCE_DIR}/src/* )
